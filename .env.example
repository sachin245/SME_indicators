# Copy to .env and fill in values
# DB_PATH=data/sme_indicators.db
# PDF_CACHE_DIR=data/pdfs/
# REQUEST_DELAY=1.5

# OpenAI — enables fast AI-powered extraction (signals + financials in one call)
# OPENAI_API_KEY=sk-...

# Parallel PDF workers
# PDF_WORKERS=10

# Set to false to force legacy regex/pdfplumber extraction
# USE_AI_PARSER=true

# Max filings per parser batch
# BATCH_SIZE=500
